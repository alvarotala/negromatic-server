<div class="container-fluid p-0 d-flex flex-grow-1">
  <%= erb :sidebar %>

  <main class="main-content d-flex flex-column">
    <%= erb :header %>

    <div class="p-4">
      <div class="row justify-content-center">
        <div class="col-md-8">
          <div class="card bg-dark border-secondary shadow-lg">
            <div class="card-header border-secondary bg-transparent py-3 d-flex justify-content-between align-items-center">
              <h4 class="mb-0 fw-bold">Edit Assistant: <%= @assistant.name %></h4>
              <span class="text-muted small">ID: <%= @assistant.id %></span>
            </div>
            <div class="card-body p-4">
              <form action="/assistants/<%= @assistant.id %>" method="POST">
                <div class="mb-4">
                  <label for="name" class="form-label small fw-semibold text-muted text-uppercase">Assistant Name</label>
                  <input type="text" class="form-control bg-dark text-light border-secondary" id="name" name="name" value="<%= @assistant.name %>" required>
                </div>

                <div class="mb-4">
                  <label for="identity" class="form-label small fw-semibold text-muted text-uppercase">Identity / System Prompt</label>
                  <textarea class="form-control bg-dark text-light border-secondary" id="identity" name="identity" rows="12" required><%= @assistant.identity %></textarea>
                  <div class="form-text">This defines the core personality and behavior of the assistant.</div>
                </div>

                <div class="mb-4">
                  <label for="global_memory" class="form-label small fw-semibold text-muted text-uppercase">Global Knowledge Base</label>
                  <textarea class="form-control bg-dark text-light border-secondary" id="global_memory" name="global_memory" rows="6"><%= @assistant.global_memory %></textarea>
                  <div class="form-text">Long-term knowledge, company info, and persistent facts.</div>
                </div>

                <div class="d-grid gap-2 pt-3">
                  <button type="submit" class="btn btn-primary btn-lg fw-bold">Update Assistant</button>
                  <a href="/assistants" class="btn btn-outline-secondary">Cancel</a>
                </div>
              </form>
            </div>
          </div>
          
          <div class="mt-5">
            <h5 class="mb-3 fw-bold">Active Channels</h5>
            <div class="list-group list-group-flush border border-secondary rounded overflow-hidden">
              <% if @assistant.channels.empty? %>
                <div class="list-group-item bg-dark text-muted py-4 text-center">
                  No channels configured for this assistant.
                </div>
              <% else %>
                <% @assistant.channels.each do |channel| %>
                  <div class="list-group-item bg-dark text-light border-secondary py-3 d-flex justify-content-between align-items-center">
                    <div>
                      <strong class="d-block"><%= channel.provider.capitalize %></strong>
                      <div class="small text-muted"><%= channel.provider_uid %></div>
                    </div>
                    <div>
                      <% if channel.active %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3">Active</span>
                      <% else %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3">Inactive</span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
