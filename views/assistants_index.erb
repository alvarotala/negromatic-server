<div class="container-fluid p-0 d-flex flex-grow-1">
  <%= erb :sidebar %>

  <main class="main-content d-flex flex-column flex-grow-1">
    <%= erb :header %>

    <div class="p-4 p-lg-5">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-5">
        <div>
          <h2 class="h3 mb-1 fw-bold text-white">Virtual Assistants</h2>
          <p class="text-muted small mb-0">Your distributed AI workforce across all channels</p>
        </div>
        <div>
          <a href="/assistants/new" class="btn btn-primary px-4">
            Create Assistant
          </a>
        </div>
      </div>

      <div class="row g-4">
        <% if @assistants.empty? %>
          <div class="col-12">
            <div class="card bg-dark border-secondary border-dashed py-5 text-center">
              <div class="card-body">
                <h4 class="text-white mb-3">No assistants found</h4>
                <p class="text-muted mb-4">Start by deploying your first AI agent.</p>
                <a href="/assistants/new" class="btn btn-primary px-5">Create New Assistant</a>
              </div>
            </div>
          </div>
        <% else %>
          <% @assistants.each do |assistant| %>
            <div class="col-md-6 col-xl-4">
              <div class="card h-100 shadow-sm border-secondary border-opacity-25">
                <div class="card-body d-flex flex-column">
                  <div class="d-flex justify-content-between align-items-start mb-3">
                    <h5 class="card-title fw-bold text-white mb-0"><%= assistant.name %></h5>
                    <div class="badge bg-white bg-opacity-10 text-white small">Active</div>
                  </div>
                  
                  <p class="card-text text-muted small mb-4 flex-grow-1">
                    <%= assistant.identity.to_s.truncate(140) %>
                  </p>
                  
                  <div class="d-flex gap-3 mb-4">
                    <div class="text-white">
                      <span class="d-block h6 mb-0"><%= assistant.channels.count %></span>
                      <span class="text-muted small">Channels</span>
                    </div>
                    <div class="text-white">
                      <span class="d-block h6 mb-0"><%= assistant.contacts.count %></span>
                      <span class="text-muted small">Contacts</span>
                    </div>
                  </div>

                  <div class="pt-3 border-top border-secondary border-opacity-10">
                    <a href="/assistants/<%= assistant.id %>/edit" class="btn btn-outline-secondary btn-sm w-100">Edit Agent</a>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </main>
</div>
