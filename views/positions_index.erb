<div class="container-fluid p-0 d-flex flex-grow-1">
  <%= erb :sidebar %>

  <!-- Main Content -->
  <main class="main-content d-flex flex-column">
    <%= erb :header %>

    <div class="p-4 overflow-auto">
      <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/dashboard" class="text-decoration-none text-info">Dashboard</a></li>
          <li class="breadcrumb-item active text-muted" aria-current="page">Positions</li>
        </ol>
      </nav>

      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="h3 mb-1 fw-bold">Positions</h2>
          <p class="text-muted small mb-0">History of closed positions (most recent first)</p>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-12">
          <div class="card shadow-lg border-0 bg-dark bg-opacity-25">
            <div class="card-body p-0">
              <% if @positions && @positions.any? %>
                <div class="table-responsive">
                  <table class="table table-hover align-middle mb-0">
                    <thead>
                      <tr class="text-muted small text-uppercase">
                        <th class="ps-4 py-3 border-secondary border-opacity-10">Closed</th>
                        <th class="py-3 border-secondary border-opacity-10">Asset</th>
                        <th class="py-3 border-secondary border-opacity-10">Side</th>
                        <th class="py-3 border-secondary border-opacity-10 text-end">Amount</th>
                        <th class="py-3 border-secondary border-opacity-10 text-end">Realized PnL</th>
                        <th class="py-3 border-secondary border-opacity-10 text-end">Realized %</th>
                        <th class="text-end pe-4 py-3 border-secondary border-opacity-10">Close Reason</th>
                      </tr>
                    </thead>
                    <tbody class="border-top-0">
                      <% @positions.each do |pos| %>
                        <%
                          pnl = pos.realized_pnl.to_f
                          pnl_pct = pos.realized_pnl_percentage.to_f
                          close_audit = pos.info.is_a?(Hash) ? pos.info['closeAudit'] : nil
                          close_reason = pos.respond_to?(:close_reason) ? pos.close_reason : nil
                          
                          # Determine badge style based on close reason
                          reason_badge = case close_reason
                          when 'telemetry_gone'
                            { class: 'bg-primary bg-opacity-10 text-primary', label: 'Auto Close', title: 'Position disappeared from exchange telemetry' }
                          when 'ai_full_close'
                            { class: 'bg-info bg-opacity-10 text-info', label: 'AI Full Close', title: 'AI issued 100% close order' }
                          when 'ai_partial_close'
                            { class: 'bg-cyan bg-opacity-10 text-info', label: 'AI Partial', title: 'AI profit taking (partial close)' }
                          when 'stale_confirmed'
                            { class: 'bg-success bg-opacity-10 text-success', label: 'Confirmed', title: 'Human confirmed stale position was closed' }
                          when 'manual_archive'
                            { class: 'bg-warning bg-opacity-10 text-warning', label: 'Archived', title: 'Manually archived (not counted in stats)' }
                          else
                            # Legacy positions without close_reason (pre-migration)
                            { class: 'bg-secondary bg-opacity-10 text-secondary', label: 'Legacy', title: 'Pre-migration close (run DB migration to categorize)' }
                          end
                          
                          # Check if it's stats eligible
                          stats_eligible = Position::STATS_ELIGIBLE_REASONS.include?(close_reason.to_s) rescue true
                        %>
                        <tr class="<%= 'opacity-50' unless stats_eligible %>">
                          <td class="ps-4 py-3">
                            <span class="text-muted small"><%= pos.closed_at ? pos.closed_at.strftime('%Y-%m-%d %H:%M') : '-' %></span>
                            <% if close_audit.is_a?(Hash) && close_audit['dispatchedAt'] %>
                              <div class="text-muted small" style="font-size: 0.65rem;">
                                Dispatched: <%= close_audit['dispatchedAt'].to_s.gsub('T', ' ').gsub('Z', '') %>
                              </div>
                            <% end %>
                          </td>
                          <td class="py-3">
                            <div class="text-light fw-medium"><%= pos.asset.value %></div>
                          </td>
                          <td class="py-3">
                            <% if pos.side.to_s.downcase == 'long' %>
                              <span class="badge bg-success-subtle text-success px-2 py-1">LONG</span>
                            <% else %>
                              <span class="badge bg-danger-subtle text-danger px-2 py-1">SHORT</span>
                            <% end %>
                          </td>
                          <td class="py-3 text-light fw-medium text-end"><%= pos.amount %></td>
                          <td class="py-3 text-end">
                            <% if close_reason == 'manual_archive' %>
                              <span class="text-muted">-</span>
                            <% elsif close_reason == 'ai_partial_close' %>
                              <span class="<%= pnl >= 0 ? 'text-success' : 'text-danger' %>"
                                    data-bs-toggle="tooltip" 
                                    title="Estimated profit from partial close (<%= close_audit.is_a?(Hash) && close_audit['closeRatio'] ? (close_audit['closeRatio'].to_f * 100).round(1) : '?' %>% of position)">
                                ~<%= pnl >= 0 ? '+' : '' %><%= sprintf('%.2f', pnl) %>
                              </span>
                            <% else %>
                              <span class="<%= pnl >= 0 ? 'text-success' : 'text-danger' %> fw-bold">
                                <%= pnl >= 0 ? '+' : '' %><%= sprintf('%.2f', pnl) %>
                              </span>
                            <% end %>
                          </td>
                          <td class="py-3 text-end">
                            <% if close_reason == 'manual_archive' %>
                              <span class="text-muted">-</span>
                            <% elsif close_reason == 'ai_partial_close' %>
                              <span class="<%= pnl_pct >= 0 ? 'text-success' : 'text-danger' %>">
                                ~<%= pnl_pct >= 0 ? '+' : '' %><%= sprintf('%.2f', pnl_pct) %>%
                              </span>
                            <% else %>
                              <span class="<%= pnl_pct >= 0 ? 'text-success' : 'text-danger' %> fw-bold">
                                <%= pnl_pct >= 0 ? '+' : '' %><%= sprintf('%.2f', pnl_pct) %>%
                              </span>
                            <% end %>
                          </td>
                          <td class="text-end pe-4 py-3">
                            <div class="d-inline-flex align-items-center gap-2">
                              <span class="badge <%= reason_badge[:class] %>"
                                    data-bs-toggle="tooltip"
                                    data-bs-placement="top"
                                    title="<%= reason_badge[:title] %><% if close_audit.is_a?(Hash) && close_audit['actionId'] %> | Action ID: <%= close_audit['actionId'] %><% end %><% if close_audit.is_a?(Hash) && close_audit['actionAmount'].to_f > 0 %> | Amount: <%= close_audit['actionAmount'] %><% end %>">
                                <%= reason_badge[:label] %>
                              </span>
                              <% unless stats_eligible %>
                                <span class="badge bg-secondary bg-opacity-25 text-muted" style="font-size: 0.6rem;">
                                  No stats
                                </span>
                              <% end %>
                              <a href="/extensions/<%= pos.extension_id %>/assets/<%= pos.asset_id %>/debug" class="text-decoration-none" title="Debug">
                                <span class="small">🐛</span>
                              </a>
                            </div>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% else %>
                <div class="text-center py-5">
                  <div class="mb-3">
                    <span style="font-size: 3.5rem; filter: grayscale(0.5);">🧾</span>
                  </div>
                  <h4 class="h5 fw-bold">No closed positions yet</h4>
                  <p class="text-muted mb-0 px-5">Once positions are closed, they will appear here.</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Legend -->
      <div class="mt-4">
        <div class="card shadow-sm border-0 bg-dark bg-opacity-25">
          <div class="card-body py-3">
            <div class="mb-2">
              <span class="text-muted small fw-bold me-3">Close Reasons:</span>
              <span class="badge bg-primary bg-opacity-10 text-primary me-2">Auto Close</span>
              <span class="text-muted small me-3">Telemetry gone</span>
              <span class="badge bg-info bg-opacity-10 text-info me-2">AI Full Close</span>
              <span class="text-muted small me-3">100% close</span>
              <span class="badge bg-cyan bg-opacity-10 text-info me-2">AI Partial</span>
              <span class="text-muted small me-3">Profit taking*</span>
              <span class="badge bg-success bg-opacity-10 text-success me-2">Confirmed</span>
              <span class="text-muted small me-3">Human verified</span>
              <span class="badge bg-warning bg-opacity-10 text-warning me-2">Archived</span>
              <span class="text-muted small">No stats</span>
            </div>
            <div class="text-muted small">
              <em>* AI Partial closes show estimated profit (~) based on the % of position closed. On Binance Futures, partial closes create a new position, so we estimate at dispatch time.</em>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
  tooltipTriggerList.forEach(function (tooltipTriggerEl) {
    new bootstrap.Tooltip(tooltipTriggerEl)
  });
});
</script>
