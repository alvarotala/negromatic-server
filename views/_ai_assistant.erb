<div class="card shadow-lg border-0 bg-dark bg-opacity-25 sticky-top" style="top: 85px;">
  <div class="card-body p-4">
    <h3 class="h6 fw-bold mb-3 d-flex align-items-center gap-2">
      <span style="font-size: 1.2rem;">✨</span> AI Assistant
    </h3>
    <p class="text-muted small mb-3"><%= (defined?(description) && description) || "Describe how you want to change the content, and the AI will update it for you." %></p>
    
    <div class="mb-3">
      <textarea id="ai-instruction" class="form-control bg-dark border-secondary text-light small" rows="4" 
                placeholder="<%= (defined?(placeholder) && placeholder) || "e.g., 'Make this more concise' or 'Add a rule for...'" %>"></textarea>
    </div>
    
    <button type="button" id="apply-ai-btn" 
            class="btn btn-info w-100 fw-semibold d-flex align-items-center justify-content-center gap-2"
            data-target="<%= (defined?(target) && target) || "#content" %>"
            data-endpoint="<%= (defined?(endpoint) && endpoint) || "/api/ai/strategy_edit" %>">
      <span id="ai-btn-text">Apply with AI</span>
      <span id="ai-loader" class="spinner-border spinner-border-sm d-none" role="status"></span>
    </button>
    
    <div class="mt-3 small text-muted">
      <i class="bi bi-info-circle me-1"></i>
      Tip: You can use Ctrl+Z / Cmd+Z to undo any AI changes.
    </div>
  </div>
</div>

<!-- AI Diff Modal -->
<div class="modal fade" id="aiDiffModal" tabindex="-1" aria-labelledby="aiDiffModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content bg-dark border-secondary shadow-lg">
      <div class="modal-header border-secondary">
        <h5 class="modal-title fw-bold text-light d-flex align-items-center gap-2" id="aiDiffModalLabel">
          <span>✨</span> AI Proposed Changes
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0">
        <div id="ai-diff-container" class="diff-view p-3" style="font-family: 'JetBrains Mono', 'Fira Code', monospace; font-size: 0.85rem; line-height: 1.5; background: #0d1117; color: #c9d1d9;">
          <!-- Diff content will be injected here -->
        </div>
      </div>
      <div class="modal-footer border-secondary bg-dark bg-opacity-50">
        <div class="me-auto small text-muted">
          <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">+ Added</span>
          <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 ms-1">- Removed</span>
        </div>
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="confirm-ai-apply" class="btn btn-info fw-bold px-4">Apply Changes</button>
      </div>
    </div>
  </div>
</div>

<style>
  .diff-view {
    white-space: pre-wrap;
    word-break: break-all;
  }
  .diff-added {
    background-color: rgba(46, 160, 67, 0.15);
    color: #3fb950;
    display: block;
    margin: 0 -1rem;
    padding: 0 1rem;
  }
  .diff-removed {
    background-color: rgba(248, 81, 73, 0.15);
    color: #f85149;
    display: block;
    margin: 0 -1rem;
    padding: 0 1rem;
    text-decoration: line-through;
  }
  .diff-unchanged {
    opacity: 0.8;
  }
</style>

<script src="/js/ai_assistant.js"></script>
