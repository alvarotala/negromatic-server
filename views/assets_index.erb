<div class="container-fluid p-0 d-flex flex-grow-1">
  <%= erb :sidebar %>

  <!-- Main Content -->
  <main class="main-content d-flex flex-column">
    <%= erb :header %>

    <div class="p-4 overflow-auto">
      <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/dashboard" class="text-decoration-none text-info">Dashboard</a></li>
          <li class="breadcrumb-item active text-muted" aria-current="page">Active Assets</li>
        </ol>
      </nav>

      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h2 class="h3 mb-1 fw-bold">Active Assets</h2>
          <p class="text-muted small mb-0">Monitor and debug active tokens across your accounts</p>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-12">
          <div class="card shadow-lg border-0 bg-dark bg-opacity-25">
            <div class="card-body p-0">
              <% if @active_assets.any? %>
                <div class="table-responsive">
                  <table class="table table-hover align-middle mb-0">
                    <thead>
                      <tr class="text-muted small text-uppercase">
                        <th class="ps-4 py-3 border-secondary border-opacity-10">Asset</th>
                        <th class="py-3 border-secondary border-opacity-10">Account / Extension</th>
                        <th class="py-3 border-secondary border-opacity-10">Status</th>
                        <th class="py-3 border-secondary border-opacity-10">Last Activity</th>
                        <th class="text-end pe-4 py-3 border-secondary border-opacity-10">Actions</th>
                      </tr>
                    </thead>
                    <tbody class="border-top-0">
                      <% @active_assets.each do |ae| %>
                        <tr>
                          <td class="ps-4 py-3">
                            <div class="d-flex align-items-center">
                              <div class="fw-bold text-light"><%= ae.asset.value %></div>
                              <span class="ms-2 badge rounded-pill bg-secondary bg-opacity-25 text-muted fw-normal x-small"><%= ae.asset.ex_type %></span>
                            </div>
                          </td>
                          <td class="py-3">
                            <div class="text-info small fw-semibold"><%= ae.extension.account %></div>
                            <div class="text-muted x-small"><%= ae.extension.uuid.truncate(12) %></div>
                          </td>
                          <td class="py-3">
                            <% if ae.status == 'ready' %>
                              <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                <span class="spinner-grow spinner-grow-sm me-1" role="status" aria-hidden="true" style="width: 8px; height: 8px;"></span>
                                Ready
                              </span>
                            <% else %>
                              <span class="badge bg-secondary bg-opacity-10 text-muted border border-secondary border-opacity-25 px-2 py-1">
                                Idle
                              </span>
                            <% end %>
                          </td>
                          <td class="py-3 text-muted small">
                            <% if ae.last_activity_at %>
                              <%= ae.last_activity_at.strftime("%H:%M:%S") %>
                              <div class="x-small text-muted"><%= time_ago_in_words(ae.last_activity_at) %> ago</div>
                            <% else %>
                              Never
                            <% end %>
                          </td>
                          <td class="text-end pe-4 py-3">
                            <a href="/extensions/<%= ae.extension_id %>/assets/<%= ae.asset_id %>/debug" class="btn btn-sm btn-outline-info rounded-pill px-3">
                              Debug
                            </a>
                          </td>
                        </tr>
                      <% end %>
                    </tbody>
                  </table>
                </div>
              <% else %>
                <div class="text-center py-5">
                  <div class="mb-3 text-muted" style="font-size: 3rem;">🪙</div>
                  <h4 class="h5 fw-bold">No active assets</h4>
                  <p class="text-muted mb-4 px-5">You haven't linked any assets to your extensions yet.</p>
                  <a href="/dashboard" class="btn btn-primary px-4">Go to Dashboard</a>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
