<div class="container-fluid p-0 d-flex flex-grow-1">
  <%= erb :sidebar %>

  <!-- Main Content -->
  <main class="main-content d-flex flex-column">
    <%= erb :header %>

    <div class="p-4">
      <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/dashboard" class="text-decoration-none text-info">Dashboard</a></li>
          <li class="breadcrumb-item"><a href="/strategies" class="text-decoration-none text-info">Strategies</a></li>
          <li class="breadcrumb-item active text-muted" aria-current="page">Edit Strategy</li>
        </ol>
      </nav>

      <div class="mb-4">
        <h2 class="h3 mb-1 fw-bold">Edit Strategy</h2>
        <p class="text-muted small mb-0">Update your trading strategy rules</p>
      </div>

      <div class="row">
        <div class="col-md-8">
          <div class="card shadow-lg border-0 bg-dark bg-opacity-25 mb-4">
            <div class="card-body p-4">
              <form action="/strategies/<%= @strategy.id %>" method="POST">
                <div class="mb-4">
                  <label for="name" class="form-label small fw-semibold text-muted text-uppercase">Strategy Name</label>
                  <input type="text" name="name" id="name" class="form-control" value="<%= @strategy.name %>" required>
                </div>
                <div class="mb-4">
                  <label for="content" class="form-label small fw-semibold text-muted text-uppercase">Strategy Content / Rules</label>
                  <textarea name="content" id="content" class="form-control font-monospace strategy-editor" rows="15"><%= @strategy.content %></textarea>
                </div>
                <div class="mb-4">
                  <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="active" id="active" role="switch" <%= @strategy.active ? 'checked' : '' %>>
                    <label class="form-check-label small fw-semibold text-muted text-uppercase" for="active">Set as Active Strategy</label>
                    <p class="text-muted small mt-1">Activating this will automatically deactivate any other active strategy.</p>
                  </div>
                </div>
                <div class="d-flex gap-2 pt-2">
                  <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">Save Changes</button>
                  <a href="/strategies" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
                </div>
              </form>
            </div>
          </div>

          <!-- Danger Zone -->
          <div class="card shadow-lg border-danger-subtle bg-danger-subtle bg-opacity-10">
            <div class="card-header bg-danger text-white py-3">
              <h3 class="card-title h6 mb-0 fw-bold">Danger Zone</h3>
            </div>
            <div class="card-body p-4">
              <p class="text-muted small mb-4">Deleting this strategy will permanently remove it from your account. This action cannot be undone.</p>
              <form action="/strategies/<%= @strategy.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this strategy? This action cannot be undone.');">
                <button type="submit" class="btn btn-danger px-4 fw-bold">Delete Strategy</button>
              </form>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <%= erb :_ai_assistant, locals: { 
            description: "Describe how you want to change the strategy, and the AI will update it for you.",
            placeholder: "e.g., 'Add a rule to only close positions if profit is > 3%' or 'Rewrite this to be more concise'"
          } %>
        </div>
      </div>
    </div>
  </main>
</div>
