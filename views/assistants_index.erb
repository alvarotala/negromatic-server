<div class="container-fluid p-0 d-flex flex-grow-1">
  <%= erb :sidebar %>

  <main class="main-content d-flex flex-column">
    <%= erb :header %>

    <div class="p-4">
      <div class="row mb-4">
        <div class="col-md-6">
          <h2 class="h3 mb-1 fw-bold">Virtual Assistants</h2>
          <p class="text-muted small mb-0">Manage your AI agents across all channels</p>
        </div>
        <div class="col-md-6 text-end">
          <a href="/assistants/new" class="btn btn-primary px-4">
            Create Assistant
          </a>
        </div>
      </div>

      <div class="row">
        <% if @assistants.empty? %>
          <div class="col-12">
            <div class="card bg-dark border-secondary">
              <div class="card-body text-center py-5">
                <h4 class="text-secondary">No assistants yet</h4>
                <p class="mb-4">Start by creating your first virtual assistant.</p>
                <a href="/assistants/new" class="btn btn-primary">Create New Assistant</a>
              </div>
            </div>
          </div>
        <% else %>
          <% @assistants.each do |assistant| %>
            <div class="col-md-4 mb-4">
              <div class="card bg-dark border-secondary h-100 shadow-sm">
                <div class="card-body">
                  <h5 class="card-title fw-bold"><%= assistant.name %></h5>
                  <p class="card-text text-secondary small mb-3">
                    <%= assistant.identity.to_s.truncate(120) %>
                  </p>
                  <div class="d-flex gap-2">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><%= assistant.channels.count %> Channels</span>
                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><%= assistant.contacts.count %> Contacts</span>
                  </div>
                </div>
                <div class="card-footer border-secondary bg-transparent d-flex justify-content-between">
                  <a href="/assistants/<%= assistant.id %>/edit" class="btn btn-sm btn-outline-light">Edit Identity</a>
                  <form action="/assistants/<%= assistant.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this assistant?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                  </form>
                </div>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </main>
</div>
