<div class="landing-wrap min-vh-100 d-flex flex-column">
  <nav class="navbar py-3 sticky-top">
    <div class="container d-flex align-items-center justify-content-between">
      <a href="/" class="text-decoration-none d-flex align-items-center gap-2">
        <span class="brand-badge text-white">🤖</span>
        <span class="fw-bold text-white mb-0 h4">Negromatic</span>
      </a>

      <div class="d-flex align-items-center gap-4">
        <a href="/login" class="text-muted text-decoration-none small fw-semibold">Sign in</a>
        <a href="/assistants" class="btn btn-primary btn-sm px-4">Dashboard</a>
      </div>
    </div>
  </nav>

  <main class="container d-flex flex-column justify-content-center flex-grow-1 py-5 mt-lg-5">
    <div class="row align-items-center g-5">
      <div class="col-lg-7">
        <h1 class="hero-title mb-4">
          <span class="hero-gradient">Virtual Assistants.</span><br>
          <span class="text-white">Orchestrated by AI.</span>
        </h1>
        
        <p class="lead text-muted mb-5 pe-lg-5" style="font-size: 1.25rem;">
          Deploy autonomous agents across WhatsApp, Telegram, and Instagram. 
          Each assistant with its own identity, memory, and supervisor loop.
        </p>

        <div class="d-flex gap-3">
          <a href="/login" class="btn btn-primary btn-lg px-5">Get Started</a>
          <a href="/assistants/new" class="btn btn-outline-secondary btn-lg px-5">Create Assistant</a>
        </div>
      </div>

      <div class="col-lg-5 d-none d-lg-block">
        <div class="strategy-preview shadow-2xl">
          <div class="text-muted mb-3 opacity-50">// Jennifer Assistant v1.0</div>
          <div class="mb-2"><span class="text-white">role:</span> "Receptionist"</div>
          <div class="mb-2"><span class="text-white">channels:</span> ["WhatsApp", "Instagram"]</div>
          <div class="mb-2"><span class="text-white">memory:</span> "Open 9-6, Services..."</div>
          <div class="mb-0"><span class="text-white">status:</span> "Online"</div>
        </div>
      </div>
    </div>
  </main>

  <footer class="py-5 mt-auto border-top border-secondary border-opacity-10">
    <div class="container">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
        <div class="text-muted small">
          © <%= Time.now.year %> Negromatic. Built for autonomous commerce.
        </div>
        <div class="d-flex gap-4">
          <a href="https://negromatic.contentor.io" class="text-muted text-decoration-none small">negromatic.contentor.io</a>
          <a href="https://github.com" target="_blank" class="text-muted text-decoration-none small">GitHub</a>
        </div>
      </div>
    </div>
  </footer>
</div>
