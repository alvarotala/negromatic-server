<div class="container-fluid p-0 d-flex flex-grow-1">
  <%= erb :sidebar %>

  <!-- Main Content -->
  <main class="main-content d-flex flex-column">
    <%= erb :header %>

    <div class="p-4">
      <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/assistants" class="text-decoration-none text-info">Assistants</a></li>
          <li class="breadcrumb-item active text-muted" aria-current="page">Settings</li>
        </ol>
      </nav>

      <div class="mb-4">
        <h2 class="h3 mb-1 fw-bold">Account Settings</h2>
        <p class="text-muted small mb-0">Manage your profile and security</p>
      </div>

      <div class="row">
        <div class="col-md-6">
          <div class="card shadow-lg border-0 bg-dark bg-opacity-25">
            <div class="card-body p-4">
              <form action="/settings" method="POST">
                <div class="mb-4">
                  <label for="email" class="form-label small fw-semibold text-muted text-uppercase">Email Address</label>
                  <input type="email" name="email" id="email" class="form-control" value="<%= @user.email %>" required>
                  <div class="form-text">Your supervisor email address for logging in.</div>
                </div>

                <hr class="my-4 border-secondary opacity-25">
                
                <h4 class="h6 mb-3 fw-bold text-primary-emphasis">Update Password</h4>
                
                <div class="mb-3">
                  <label for="password" class="form-label small fw-semibold text-muted text-uppercase">New Password</label>
                  <input type="password" name="password" id="password" class="form-control" placeholder="Leave blank to keep current password" autocomplete="new-password">
                </div>
                
                <div class="mb-4">
                  <label for="password_confirmation" class="form-label small fw-semibold text-muted text-uppercase">Confirm New Password</label>
                  <input type="password" name="password_confirmation" id="password_confirmation" class="form-control" placeholder="Repeat the new password" autocomplete="new-password">
                </div>

                <div class="d-flex gap-2 pt-2">
                  <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold">Save Changes</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
