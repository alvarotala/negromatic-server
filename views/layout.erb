<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= @title || "Negromatic" %></title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5.3 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <!-- Core Styles -->
  <link href="/css/style.css" rel="stylesheet">
  
  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>
  <div class="flash-messages position-fixed top-0 start-0 end-0 z-3">
    <% if flash[:error] %>
      <div class="alert alert-danger alert-dismissible fade show m-0 rounded-0 border-0 text-center py-2" role="alert">
        <span class="small fw-bold text-uppercase me-2">Error</span>
        <span class="small fw-medium"><%= flash[:error] %></span>
        <button type="button" class="btn-close btn-close-white small p-2" data-bs-dismiss="alert"></button>
      </div>
    <% end %>
    <% if flash[:notice] %>
      <div class="alert alert-success alert-dismissible fade show m-0 rounded-0 border-0 text-center py-2" role="alert">
        <span class="small fw-bold text-uppercase me-2">Notice</span>
        <span class="small fw-medium"><%= flash[:notice] %></span>
        <button type="button" class="btn-close btn-close-white small p-2" data-bs-dismiss="alert"></button>
      </div>
    <% end %>
  </div>
  
  <%= yield %>
</body>
</html>
