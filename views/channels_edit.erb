<div class="container-fluid p-0 d-flex flex-grow-1">
  <%= erb :sidebar %>

  <main class="main-content d-flex flex-column flex-grow-1">
    <%= erb :header %>

    <div class="p-4 p-lg-5">
      <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
          <div class="card shadow-2xl border-secondary border-opacity-10 mb-5">
            <div class="card-header border-0 py-4 d-flex justify-content-between align-items-center">
              <div>
                <h3 class="mb-0 fw-bold text-white">Edit Channel</h3>
                <p class="text-muted mb-0 mt-2 small"><%= @channel.provider.capitalize %> integration for <%= @channel.assistant.name %></p>
              </div>
              <form action="/channels/<%= @channel.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this channel connection?');">
                <button type="submit" class="btn btn-outline-danger btn-sm">Delete Channel</button>
              </form>
            </div>
            
            <div class="card-body p-4 p-lg-5">
              <form action="/channels/<%= @channel.id %>" method="POST">
                
                <div class="mb-4">
                  <label class="form-label">Provider</label>
                  <input type="text" class="form-control" value="<%= @channel.provider.capitalize %>" disabled>
                  <div class="form-text">Provider cannot be changed. Delete and re-create if needed.</div>
                </div>

                <div class="mb-4">
                  <label for="provider_uid" class="form-label">Identifier (UID)</label>
                  <input type="text" class="form-control" id="provider_uid" name="provider_uid" value="<%= @channel.provider_uid %>" required>
                </div>

                <div class="mb-5">
                  <label for="config_json" class="form-label">Configuration (JSON)</label>
                  <textarea class="form-control font-monospace text-warning small" id="config_json" name="config_json" rows="8"><%= JSON.pretty_generate(@channel.config || {}) rescue "{}" %></textarea>
                </div>

                <div class="form-check form-switch mb-5">
                  <input class="form-check-input" type="checkbox" id="active" name="active" value="true" <%= 'checked' if @channel.active %>>
                  <label class="form-check-label text-white" for="active">Channel Active</label>
                </div>

                <div class="d-flex gap-3">
                  <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                  <a href="/assistants/<%= @channel.assistant.id %>/edit" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
