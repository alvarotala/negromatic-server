<div class="container-fluid p-0 d-flex flex-grow-1">
  <%= erb :sidebar %>

  <main class="main-content d-flex flex-column flex-grow-1">
    <%= erb :header %>

    <div class="p-4 p-lg-5">
      <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
          <div class="card shadow-2xl border-secondary border-opacity-10 mb-5">
            <div class="card-header border-0 py-4">
              <h3 class="mb-0 fw-bold text-white">Add Channel</h3>
              <p class="text-muted mb-0 mt-2 small">Connect a new communication platform to <%= @assistant.name %>.</p>
            </div>
            
            <div class="card-body p-4 p-lg-5">
              <form action="/assistants/<%= @assistant.id %>/channels" method="POST">
                <div class="mb-4">
                  <label for="provider" class="form-label">Provider</label>
                  <select class="form-select form-control" id="provider" name="provider" required>
                    <option value="" disabled selected>Select a platform...</option>
                    <% Channel.providers.each do |p| %>
                      <option value="<%= p %>"><%= p.capitalize %></option>
                    <% end %>
                  </select>
                </div>

                <div class="mb-4">
                  <label for="provider_uid" class="form-label">Identifier (UID)</label>
                  <input type="text" class="form-control" id="provider_uid" name="provider_uid" placeholder="e.g. Phone Number, Bot Username, or Page ID" required>
                  <div class="form-text">The unique ID used by the platform (e.g., +15550199 for WhatsApp).</div>
                </div>

                <div class="mb-5">
                  <label for="config_json" class="form-label">Configuration (JSON)</label>
                  <textarea class="form-control font-monospace text-warning small" id="config_json" name="config_json" rows="6" placeholder='{ "token": "..." }'></textarea>
                  <div class="form-text">
                    Enter API tokens, secrets, or specific settings as valid JSON.
                  </div>
                </div>
                
                <div class="form-check form-switch mb-5">
                  <input class="form-check-input" type="checkbox" id="active" name="active" value="true" checked>
                  <label class="form-check-label text-white" for="active">Enable Channel Immediately</label>
                </div>

                <div class="d-flex gap-3">
                  <button type="submit" class="btn btn-primary px-4">Create Channel</button>
                  <a href="/assistants/<%= @assistant.id %>/edit" class="btn btn-outline-secondary px-4">Cancel</a>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
