<div class="container-fluid p-0 d-flex flex-grow-1">
  <%= erb :sidebar %>

  <!-- Main Content -->
  <main class="main-content d-flex flex-column">
    <%= erb :header %>

    <div class="p-4 overflow-auto" id="dashboard-content">
      <%= erb :_dashboard_content %>
    </div>
  </main>
</div>

<script>
(function() {
  'use strict';

  let pollingInterval = null;
  const REFRESH_INTERVAL = 15000; // 15 seconds

  // Update extension status display and toggle button
  function updateExtensionStatus(extensionId, status) {
    const badgeContainer = document.getElementById(`status-badge-${extensionId}`);
    if (badgeContainer) {
      if (status === 'trading') {
        badgeContainer.innerHTML = `
          <span class="badge bg-success-subtle text-success px-3 py-2 d-inline-flex align-items-center">
            <span class="spinner-grow spinner-grow-sm me-2" role="status" aria-hidden="true" style="width: 10px; height: 10px; animation-duration: 0.75s;"></span>
            Trading
          </span>`;
      } else {
        badgeContainer.innerHTML = '<span class="badge bg-secondary-subtle text-secondary px-3 py-2">Idle</span>';
      }
    }
    
    // Update toggle button appearance
    const row = document.querySelector(`tr[data-extension-id="${extensionId}"]`);
    if (row) {
      const toggleBtn = row.querySelector('.toggle-action-btn');
      if (toggleBtn) {
        if (status === 'trading') {
          toggleBtn.className = 'btn btn-sm btn-outline-danger toggle-action-btn';
          toggleBtn.setAttribute('data-action', 'stop');
          toggleBtn.setAttribute('title', 'Stop');
          toggleBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-stop-fill" viewBox="0 0 16 16"><path d="M5 3.5h6A1.5 1.5 0 0 1 12.5 5v6a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 11V5A1.5 1.5 0 0 1 5 3.5z"/></svg>';
        } else {
          toggleBtn.className = 'btn btn-sm btn-outline-success toggle-action-btn';
          toggleBtn.setAttribute('data-action', 'start');
          toggleBtn.setAttribute('title', 'Start');
          toggleBtn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" class="bi bi-play-fill" viewBox="0 0 16 16"><path d="m11.596 8.697-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z"/></svg>';
        }
      }
    }
  }

  // Handle toggle button clicks
  function handleAction(extensionUuid, extensionId) {
    console.log(`>>> Toggling status for extension: ${extensionId}`);

    fetch(`/extensions/${extensionId}/toggle_status`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        updateExtensionStatus(extensionId, data.status);
      } else {
        alert('Error: ' + (data.error || 'Could not update status'));
      }
    })
    .catch(error => {
      console.error('Error toggling status:', error);
      alert('Network error occurred while updating status.');
    });
  }

  // Fetch dashboard updates
  async function refreshDashboard() {
    try {
      const response = await fetch('/dashboard/refresh');
      
      if (response.status === 401) {
        console.warn('Session expired, reloading page...');
        window.location.reload();
        return;
      }

      if (!response.ok) throw new Error('Network response was not ok');
      const html = await response.text();
      
      const contentArea = document.getElementById('dashboard-content');
      if (contentArea) {
        contentArea.innerHTML = html;
        // Re-initialize event listeners after swapping HTML
        initializeEventListeners();
        // Re-initialize tooltips
        initializeTooltips();
      }
    } catch (error) {
      console.error('Error refreshing dashboard:', error);
      // On network errors or other issues, trigger a full reload to be safe
      window.location.reload();
    }
  }

  // Initialize event listeners
  function initializeEventListeners() {
    document.querySelectorAll('.toggle-action-btn').forEach(btn => {
      // Remove old listener if any (though innerHTML swap handles this)
      btn.onclick = function(e) {
        e.preventDefault();
        const extensionUuid = this.getAttribute('data-extension-uuid');
        const extensionId = this.getAttribute('data-extension-id');
        handleAction(extensionUuid, extensionId);
      };
    });
  }

  function initializeTooltips() {
    // Dispose of existing tooltips to prevent memory leaks and ghost tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    tooltipTriggerList.forEach(function (tooltipTriggerEl) {
      // If tooltip already exists, dispose it first
      const existing = bootstrap.Tooltip.getInstance(tooltipTriggerEl);
      if (existing) existing.dispose();
      new bootstrap.Tooltip(tooltipTriggerEl)
    });
  }

  // Initialize polling
  function startPolling() {
    if (pollingInterval) clearInterval(pollingInterval);
    pollingInterval = setInterval(refreshDashboard, REFRESH_INTERVAL);
  }

  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', function() {
    initializeEventListeners();
    initializeTooltips();
    startPolling();
  });
})();
</script>
