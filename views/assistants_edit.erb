<div class="container-fluid p-0 d-flex flex-grow-1">
  <%= erb :sidebar %>

  <main class="main-content d-flex flex-column flex-grow-1">
    <%= erb :header %>

    <div class="p-4 p-lg-5">
      <div class="row">
        <div class="col-12 mb-5">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold text-white d-flex align-items-center mb-0">
              <span class="me-2 opacity-75">🔌</span> Connected Channels
            </h5>
            <a href="/assistants/<%= @assistant.id %>/channels/new" class="btn btn-sm btn-primary px-3">
              + Add Channel
            </a>
          </div>
          <div class="row g-4">
            <% if @assistant.channels.empty? %>
              <div class="col-12">
                <div class="card border-secondary border-opacity-10 py-5 text-center">
                  <div class="text-muted small">No active channel connections.</div>
                </div>
              </div>
            <% else %>
              <% @assistant.channels.each do |channel| %>
                 <div class="col-md-6 col-xl-3">
                  <a href="/channels/<%= channel.id %>/edit" class="text-decoration-none">
                    <div class="card border-secondary border-opacity-10 h-100 channel-card-hover">
                    <div class="card-body p-4 d-flex justify-content-between align-items-center">
                      <div>
                        <strong class="d-block h6 text-white mb-1"><%= channel.provider.capitalize %></strong>
                        <div class="text-muted font-monospace small opacity-50"><%= channel.provider_uid %></div>
                      </div>
                      <div>
                        <% if channel.active %>
                          <span class="badge bg-success bg-opacity-10 text-success small">Active</span>
                        <% else %>
                          <span class="badge bg-danger bg-opacity-10 text-danger small">Inactive</span>
                        <% end %>
                      </div>
                    </div>
                    </div>
                  </a>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="col-lg-8 col-xl-8">
          <div class="card shadow-2xl border-secondary border-opacity-10 mb-5">
            <div class="card-header border-0 py-4 d-flex justify-content-between align-items-center">
              <div>
                <h3 class="mb-0 fw-bold text-white">Edit Assistant</h3>
                <p class="text-muted mb-0 mt-2 small"><%= @assistant.name %> (ID: <%= @assistant.id %>)</p>
              </div>
              <form action="/assistants/<%= @assistant.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete <%= @assistant.name %>? This will also delete all memory and history.');">
                <button type="submit" class="btn btn-outline-danger btn-sm">Delete Assistant</button>
              </form>
            </div>
            <div class="card-body p-4 p-lg-5">
              <form action="/assistants/<%= @assistant.id %>" method="POST">
                <div class="mb-5">
                  <label for="name" class="form-label">Assistant Name</label>
                  <input type="text" class="form-control" id="name" name="name" value="<%= @assistant.name %>" required>
                </div>

                <div class="mb-5">
                  <label for="identity" class="form-label">Identity / System Prompt</label>
                  <textarea class="form-control" id="identity" name="identity" rows="12" required><%= @assistant.identity %></textarea>
                </div>

                <div class="mb-5">
                  <label for="global_memory" class="form-label">Global Knowledge Base</label>
                  <textarea class="form-control" id="global_memory" name="global_memory" rows="6"><%= @assistant.global_memory %></textarea>
                </div>

                <div class="d-flex gap-3 pt-4">
                  <button type="submit" class="btn btn-primary btn-lg px-5">Update Assistant</button>
                  <a href="/assistants" class="btn btn-outline-secondary btn-lg px-4">Cancel</a>
                </div>
              </form>
            </div>
          </div>
          
        </div>
        
        <div class="col-lg-4 col-xl-4">
          <div class="mb-4">
            <h5 class="fw-bold text-white d-flex align-items-center mb-4">
              <span class="me-2 opacity-75">👥</span> Recent Contacts
            </h5>
            <div class="row g-3">
              <% if @assistant.contacts.empty? %>
                <div class="col-12">
                  <div class="card border-secondary border-opacity-10 py-5 text-center">
                    <div class="text-muted small">No contacts found.</div>
                  </div>
                </div>
              <% else %>
                <% @assistant.contacts.order(created_at: :desc).limit(6).each do |contact| %>
                  <div class="col-12">
                    <div class="card border-secondary border-opacity-10 channel-card-hover">
                      <div class="card-body p-3">
                        <div class="d-flex align-items-start">
                          <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 me-3 mt-1">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                              <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H3Zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>
                            </svg>
                          </div>
                          <div class="flex-grow-1 overflow-hidden" style="min-width: 0;">
                            <strong class="d-block h6 text-white mb-1 text-truncate"><%= contact.name %></strong>
                            <div class="d-flex flex-column gap-1">
                              <% contact.identities.each do |identity| %>
                                <div class="text-muted d-flex gap-2 small align-items-center text-truncate">
                                  <i class="opacity-50 bi bi-<%= identity.provider == 'whatsapp' ? 'whatsapp' : (identity.provider == 'instagram' ? 'instagram' : 'chat') %>"></i>
                                  <span class="text-uppercase opacity-75" style="font-size: 0.65rem;"><%= identity.provider %></span>
                                  <span class="font-monospace text-truncate"><%= identity.external_id %></span>
                                </div>
                              <% end %>
                            </div>
                            <div class="text-muted small opacity-50 mt-2" style="font-size: 0.75rem;">
                              <%= contact.created_at.strftime("%b %d, %H:%M") %>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
    </div>
  </main>
</div>
