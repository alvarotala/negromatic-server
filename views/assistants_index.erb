<div class="container-fluid py-4">
  <div class="row mb-4">
    <div class="col-md-6">
      <h2 class="mb-0">Virtual Assistants</h2>
    </div>
    <div class="col-md-6 text-end">
      <a href="/assistants/new" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Create New Assistant
      </a>
    </div>
  </div>

  <div class="row">
    <% if @assistants.empty? %>
      <div class="col-12">
        <div class="card bg-dark border-secondary">
          <div class="card-body text-center py-5">
            <h4 class="text-secondary">No assistants yet</h4>
            <p class="mb-4">Start by creating your first virtual assistant.</p>
            <a href="/assistants/new" class="btn btn-primary">Create New Assistant</a>
          </div>
        </div>
      </div>
    <% else %>
      <% @assistants.each do |assistant| %>
        <div class="col-md-4 mb-4">
          <div class="card bg-dark border-secondary h-100">
            <div class="card-body">
              <h5 class="card-title"><%= assistant.name %></h5>
              <p class="card-text text-secondary small mb-3">
                <%= assistant.identity.to_s.truncate(100) %>
              </p>
              <div class="d-flex justify-content-between align-items-center">
                <span class="badge bg-info"><%= assistant.channels.count %> Channels</span>
                <span class="badge bg-secondary"><%= assistant.contacts.count %> Contacts</span>
              </div>
            </div>
            <div class="card-footer border-secondary bg-transparent d-flex justify-content-between">
              <a href="/assistants/<%= assistant.id %>/edit" class="btn btn-sm btn-outline-light">Edit Identity</a>
              <form action="/assistants/<%= assistant.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this assistant?');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
